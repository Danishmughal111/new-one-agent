# =====================================================================
# AI COMPANY OS — Environment Configuration (EXAMPLE)
# Copy this file to `.env` and adjust values for your environment.
# NEVER commit the real `.env` file. It is ignored via .gitignore.
# =====================================================================

# ---------------------------- Application ----------------------------
APP_NAME="AI Company OS"
APP_ENV=development
DEBUG=true
# Empty prefix mounts routes at the root (e.g. /health, /agents, /tasks).
# Set to a path like /api/v1 to namespace all routes instead.
API_PREFIX=
HOST=0.0.0.0
PORT=8000

# ---------------------------- Security -------------------------------
# Secret used for internal signing/validation. Generate a strong random
# value in production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# ---------------------------- Database -------------------------------
# PostgreSQL is the production database.
DATABASE_URL=postgresql+asyncpg://ai_company:ai_company_password@localhost:5432/ai_company_os

# SQLite is used ONLY for automated tests (set by the test suite itself).
# DATABASE_URL=sqlite+aiosqlite:///./test.db

# ---------------------------- Redis ----------------------------------
# Reserved for future background task infrastructure. Phase 1 does not
# depend on Redis for task execution.
REDIS_URL=redis://localhost:6379/0

# ---------------------------- Logging --------------------------------
LOG_LEVEL=INFO
# Set LOG_FORMAT=json for structured machine-readable logs.
LOG_FORMAT=text